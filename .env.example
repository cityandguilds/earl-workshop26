# Runtime configuration (copy to .env for local use and keep secrets out of Git).
EARL_WORKSHOP_DATA_DIR=.data
EARL_WORKSHOP_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
EARL_WORKSHOP_SECURE_COOKIES=false
EARL_WORKSHOP_ENVIRONMENT=development

# Optional overrides
# EARL_WORKSHOP_DATABASE_PATH=.data/earl_workshop.sqlite3
# EARL_WORKSHOP_HOST=127.0.0.1
# EARL_WORKSHOP_PORT=8000
